{
  "expo": {
    "name": "Pascualinga",
    "slug": "Pascualinga",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/pgh_logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/pgh_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#d9802b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pascualinga.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Pascualinga needs access to your camera so you can join video consultations with your doctor.",
        "NSMicrophoneUsageDescription": "Pascualinga needs access to your microphone so you can speak during video consultations.",
        "NSPhotoLibraryUsageDescription": "Pascualinga may request photo access to attach documents to consultation records.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.pascualinga.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pgh_logo.png",
        "backgroundColor": "#d9802b"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "ACCESS_NETWORK_STATE",
        "INTERNET",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/pgh_logo.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "15432362-49f1-45fd-bd26-3d0246467859"
      }
    },
    "submit": {
      "production": {
        "ios": {
          "ascAppId": "6810953112"
        }
      }
    }
  }
}
